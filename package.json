{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "profile-weather-view",
  "private": true,
  "description": "Live Open-Meteo weather, patched into a GitHub profile README three times a day",
  "keywords": [
    "bun",
    "github-actions",
    "github-profile",
    "open-meteo",
    "readme",
    "typescript",
    "weather"
  ],
  "homepage": "https://github.com/tashfiqul-islam/profile-weather-view#readme",
  "bugs": "https://github.com/tashfiqul-islam/profile-weather-view/issues",
  "license": "MIT",
  "author": "Tashfiqul Islam (https://github.com/tashfiqul-islam)",
  "repository": "github:tashfiqul-islam/profile-weather-view",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "typecheck": "tsc",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "bun test",
    "readme:art": "bun scripts/readme-art.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@semantic-release/github": "12.0.11",
    "@types/bun": "1.4.4",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "eslint-plugin-jsdoc": "65.5.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "oxfmt",
    "oxlint",
    "oxlint-tsgolint"
  ]
}
