{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // TypeScript 7 (native tsgo) type-checks only; Bun runs the .ts sources directly.
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo",

    // Runtime: Bun ≥ 1.4 (ESNext + native Temporal, no DOM).
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["bun"],

    // Modules: bundler-style resolution, imports kept verbatim, only erasable TS syntax.
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noUncheckedSideEffectImports": true,

    // Strictness: everything on.
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,

    "skipLibCheck": true
  },
  "include": ["**/*.ts"]
}
